{
    "name": "berlin-postal-themes",
    "displayName": "Berlin Postal Themes",
    "description": "VS Code themes inspired by historic Berlin postal districts (Postzustellbezirke) - NW21 Moabit, W30 Schöneberg, SW61, SO36 and SW11 Kreuzberg",
    "version": "3.0.0",
    "icon": "super-themes.png",
    "engines": {
        "vscode": "^1.74.0"
    },
    "categories": [
        "Themes"
    ],
    "keywords": [
        "theme",
        "dark",
        "light",
        "berlin",
        "postal",
        "postzustellbezirke",
        "moabit",
        "schöneberg",
        "kreuzberg",
        "südost",
        "so36",
        "sw11",
        "südwest",
        "color-theme",
        "collection"
    ],
    "contributes": {
        "themes": [
            {
                "label": "NW21 (Nordwest 21 - Moabit)",
                "uiTheme": "vs",
                "path": "./themes/nw21-color-theme.json"
            },
            {
                "label": "SW11 (Südwest 11 - Kreuzberg)",
                "uiTheme": "vs",
                "path": "./themes/sw11-color-theme.json"
            },
            {
                "label": "W30 (West 30 - Schöneberg)",
                "uiTheme": "vs-dark",
                "path": "./themes/w30-color-theme.json"
            },
            {
                "label": "SW61 (Südwest 61 - Kreuzberg)",
                "uiTheme": "vs-dark",
                "path": "./themes/sw61-color-theme.json"
            },
            {
                "label": "SO36 (Südost 36 - Kreuzberg)",
                "uiTheme": "vs-dark",
                "path": "./themes/so36-color-theme.json"
            }
        ]
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/heikopanjas/vscode-themes"
    },
    "author": {
        "name": "Heiko Panjas"
    },
    "license": "MIT",
    "publisher": "heikopanjas",
    "scripts": {
        "build": "vsce package --out ./dist/",
        "install-local": "code --install-extension ./dist/*.vsix",
        "validate": "vsce package --out ./dist/ --no-dependencies"
    }
}
