    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "string.comment"
            ],
            "settings": {
                "foreground": "#8b949e"
            }
        },
        {
            "scope": [
                "constant.other.placeholder",
                "constant.character"
            ],
            "settings": {
                "foreground": "#ffd1dc"
            }
        },
        {
            "scope": [
                "constant",
                "entity.name.constant",
                "variable.other.constant",
                "variable.other.enummember",
                "variable.language",
                "entity"
            ],
            "settings": {
                "foreground": "#79c0ff"
            }
        },
        {
            "scope": [
